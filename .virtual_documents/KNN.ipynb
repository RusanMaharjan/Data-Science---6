df = pd.read_csv('Dataset/student.csv')
df.head()


## Continuous data to Category
df['G3'].sort_values(ascending=True).unique()


def convertMarks(marks):
    if marks >= 15:
        return 'A'
    elif marks >= 11:
        return 'B'
    elif marks >= 7:
        return 'C'
    else:
        return 'Fail'


df['Grade'] = df['G3'].apply(convertMarks)


df.columns


columns = 'Medu', 'Fedu', 'traveltime', 'studytime',
