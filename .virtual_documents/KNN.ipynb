import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Import KNN Model
from sklearn.neighbors import KNeighborsClassifier
# Import Train Test Split
from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_score, GridSearchCV
# Import Data Preprocessing Modules
from sklearn.preprocessing import StandardScaler, LabelEncoder
# Import Metrics
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score


df = pd.read_csv('Dataset/student.csv')
df.head()


## Continuous data to Category
df['G3'].sort_values(ascending=True).unique()


def convertMarks(marks):
    if marks >= 15:
        return 'A'
    elif marks >= 11:
        return 'B'
    elif marks >= 7:
        return 'C'
    else:
        return 'Fail'


df['Grade'] = df['G3'].apply(convertMarks)


df.columns


# columns = 'Medu', 'Fedu', 'traveltime', 'studytime',
#        'failures', 'schoolsup', 'famsup','nursery','internet', 'freetime', 'goout', 'Dalc','Walc',
#         'absences', 'G1', 'G2', 'Grade'

# le_columns = 'schoolsup', 'famsup','nursery','internet'





# Label Encoder
le = LabelEncoder()

def encodeData(dataframe, *args):
    for col in args:
        dataframe[f'{col}_id'] = le.fit_transform(dataframe[col])
    print('Columns Encoded.')

encodeData(df, 'schoolsup', 'famsup','nursery','internet')


# val = ['C', 'A', 'B', 'D']

# data = le.fit_transform(val)
# data
# inv_data = le.inverse_transform(data)
# inv_data


df['health'].unique()


medu_id = {
    'none': 0,
    'primary education (4th grade)': 1,
    '5th to 9th grade': 2,
    'secondary education': 3,
    'higher education': 4
}
df['medu_id'] = df['Medu'].map(medu_id)


# Manual Encoding
def manualEncode(dataframe, col, *args):
    encode_val = {}
    for idx, val in enumerate(args):
        encode_val[val] = idx

    dataframe[f'{col}_id'] = dataframe[col].map(encode_val)


manualEncode(df, 'Fedu', 'none', 'primary education (4th grade)', '5th to 9th grade','secondary education',
        'higher education')


manualEncode(df, 'traveltime', '<15 min.',  '15 to 30 min.', '30 min. to 1 hour', '>1 hour')


manualEncode(df, 'studytime', '<2 hours', '2 to 5 hours', '5 to 10 hours', '>10 hours')


manualEncode(df, 'freetime', 'very low', 'low', 'medium', 'high', 'very high')
manualEncode(df, 'goout', 'very low', 'low', 'medium', 'high', 'very high')
manualEncode(df, 'Dalc', 'very low', 'low', 'medium', 'high', 'very high')
manualEncode(df, 'Walc', 'very low', 'low', 'medium', 'high', 'very high')


manualEncode(df, 'health', 'very bad', 'bad', 'good', 'very good', 'excellent')


manualEncode(df, 'Grade', 'Fail', 'C', 'B', 'A')





features = ['medu_id', 'Fedu_id', 'traveltime_id', 'studytime_id', 'failures', 'schoolsup_id', 
             'famsup_id', 'internet_id', 'freetime_id', 'goout_id',
             'health_id', 'absences', 'G1', 'G2']
target = 'Grade_id'


X = df[features]
Y = df[target]





X_train, X_test, Y_train, Y_test = train_test_split(
    X, Y, test_size=0.2, random_state=42, stratify=Y
)





scaler = StandardScaler()
X_train_scale = scaler.fit_transform(X_train)
X_test_scale = scaler.transform(X_test)





k_range = range(1, 21)
error_rate = [] # most lowest point
acc_score = [] # most highest point

for i in k_range:
    knn = KNeighborsClassifier(n_neighbors=i)
    knn.fit(X_train_scale, Y_train)
    knn_pred = knn.predict(X_test_scale)

    error_rate.append(np.mean(Y_test != knn_pred))
    acc_score.append(accuracy_score(Y_test, knn_pred))


fig, axes = plt.subplots(1, 2, figsize=(14, 4))
plt.suptitle('Finding Optimal Number of Neighbors')

ax1 = axes[0]
ax1.plot(k_range, error_rate, marker='o')
ax1.grid(linestyle='--', alpha=0.4)
ax1.set_xlabel('K Range')
ax1.set_ylabel('Error Rate')
ax1.set_title('Elbow Method Error Rate - KNN')

ax2 = axes[1]
ax2.plot(k_range, acc_score, marker='o')
ax2.grid(linestyle='--', alpha=0.4)
ax2.set_xlabel('K Range')
ax2.set_ylabel('Accuracy Score')
ax2.set_title('Elbow Method Accuracy Score - KNN')

plt.show()


k = 5
model = KNeighborsClassifier(n_neighbors=8, n_jobs=1)
model.fit(X_train_scale, Y_train)
Y_pred = model.predict(X_test_scale)


cm = confusion_matrix(Y_test, Y_pred)
cr = classification_report(Y_test, Y_pred)


print(cm)


print(cr)


sns.heatmap(cm, annot=True)
plt.show()





kfold = StratifiedKFold(n_splits = 5, shuffle=True, random_state=42)
cv_error_rate = []
cv_acc_score = []

for i in k_range:
    knn_kfold = KNeighborsClassifier(n_neighbors=i, n_jobs=1)
    scores = cross_val_score(knn_kfold, X_train_scale, Y_train, scoring='accuracy')

    cv_error_rate.append(scores.mean())
    cv_acc_score.append(1 - scores.mean())

best_k_range = k_range[np.argmax(cv_acc_score)]
print(f'Optimal Neighbor After Cross Validation: {best_k_range}')


fig, axes = plt.subplots(1, 2, figsize=(14, 4))

ax1 = axes[0]
ax1.plot(k_range, cv_error_rate, marker='o')
ax1.grid(linestyle='--', alpha=0.4)
ax1.set_xlabel('K Range')
ax1.set_ylabel('Error Rate')
ax1.set_title('Elbow Method Error Rate - KNN')

ax2 = axes[1]
ax2.plot(k_range, cv_acc_score, marker='o')
ax2.grid(linestyle='--', alpha=0.4)
ax2.set_xlabel('K Range')
ax2.set_ylabel('Accuracy Score')
ax2.set_title('Elbow Method Accuracy Score - KNN')





params = {
    'n_neighbors': list(range(1, 35)),
    'weights': ['uniform', 'distance'],
    'metric': ['euclidean', 'manhattan']
}


grid_cv = GridSearchCV(
    estimator = KNeighborsClassifier(),
    param_grid = params,
    cv = kfold,
    n_jobs = 1
)
grid_cv.fit(X_train_scale, Y_train)
best_est = grid_cv.best_estimator_
print(best_est)


best_k_pred = grid_cv.predict(X_test_scale)


best_cm = confusion_matrix(Y_test, best_k_pred)
best_cr = classification_report(Y_test, best_k_pred)


print(best_cm)


print(best_cr)



